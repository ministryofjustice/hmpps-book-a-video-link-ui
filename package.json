{
  "name": "hmpps-book-a-video-link-ui",
  "version": "0.0.1",
  "description": "Hmpps Book A Video Link Ui",
  "repository": "git@github.com:ministryofjustice/hmpps-book-a-video-link-ui.git",
  "license": "MIT",
  "scripts": {
    "prepare": "hmpps-precommit-hooks-prepare",
    "watch-ts": "tsc -w",
    "build": "node esbuild/esbuild",
    "start": "node $NODE_OPTIONS dist/server.js | bunyan -o short",
    "start:dev": "node esbuild/esbuild --watch",
    "start-feature": "export $(cat feature.env) && $(wiremock --port 9091 --root-dir integration_tests >> /dev/null &) && node $NODE_DEBUG_OPTION dist/server.js | bunyan -o short",
    "start-feature:dev": "node esbuild/esbuild --watch --env feature.env",
    "lint": "eslint . --cache --max-warnings 0",
    "lint-fix": "eslint . --cache --max-warnings 0 --fix",
    "typecheck": "tsc && tsc -p integration_tests && tsc -p assets/js",
    "test": "TZ=utc jest",
    "test:ci": "TZ=utc jest --runInBand",
    "security_audit": "npx audit-ci --config audit-ci.json",
    "int-test": "npx playwright test",
    "int-test-ui": "npx playwright test --ui",
    "int-test-init:ci": "npx playwright install",
    "clean": "rm -rf dist test_results",
    "rebuild": "npm run clean && npm run setup && npm run build",
    "setup": "npm ci && hmpps-npm-script-run-allowlist"
  },
  "engines": {
    "node": "^24",
    "npm": "^11"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1094.0",
    "@ministryofjustice/frontend": "8.0.1",
    "@ministryofjustice/hmpps-monitoring": "^1.1.0",
    "agentkeepalive": "^4.6.0",
    "applicationinsights": "^2.9.8",
    "bunyan": "^1.8.15",
    "bunyan-format": "^0.2.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "connect-flash": "^0.1.1",
    "connect-redis": "^7.1.1",
    "csrf-sync": "^4.2.1",
    "date-fns": "^4.4.0",
    "del": "8.0.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "govuk-frontend": "^5.14.0",
    "helmet": "^8.3.0",
    "http-errors": "^2.0.1",
    "json-2-csv": "^5.5.11",
    "jwt-decode": "^4.0.0",
    "libphonenumber-js": "1.13.9",
    "lodash": "^4.18.1",
    "nocache": "^4.0.0",
    "nunjucks": "^3.2.4",
    "passport": "^0.7.0",
    "passport-oauth2": "^1.8.0",
    "redis": "^4.7.1",
    "reflect-metadata": "^0.2.2",
    "superagent": "^10.3.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@jgoz/esbuild-plugin-typecheck": "^4.0.4",
    "@ministryofjustice/eslint-config-hmpps": "1.0.3",
    "@ministryofjustice/frontend-types": "2.0.0",
    "@ministryofjustice/hmpps-npm-script-allowlist": "0.0.6",
    "@ministryofjustice/hmpps-precommit-hooks": "^3.0.1",
    "@playwright/test": "^1.61.1",
    "@rollup/plugin-commonjs": "^28.0.9",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/bunyan": "^1.8.11",
    "@types/bunyan-format": "^0.2.9",
    "@types/cheerio": "^0.22.35",
    "@types/compression": "^1.8.1",
    "@types/connect-flash": "0.0.40",
    "@types/express-session": "^1.19.0",
    "@types/http-errors": "^2.0.5",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.24",
    "@types/node": "^22.20.1",
    "@types/nunjucks": "^3.2.6",
    "@types/passport": "^1.0.17",
    "@types/passport-oauth2": "^1.8.0",
    "@types/sinon": "^17.0.4",
    "@types/superagent": "^8.1.11",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "audit-ci": "^7.1.0",
    "aws-sdk-client-mock": "^4.1.0",
    "axe-core": "^4.12.1",
    "cheerio": "^1.2.0",
    "concurrently": "^10.0.4",
    "dotenv": "^16.6.1",
    "esbuild": "^0.28.1",
    "esbuild-plugin-copy": "^2.1.1",
    "esbuild-plugin-manifest": "^1.0.5",
    "esbuild-sass-plugin": "^3.7.0",
    "jest": "^30.4.2",
    "jest-html-reporter": "^4.4.0",
    "jest-junit": "^17.0.0",
    "jsonwebtoken": "^9.0.3",
    "lint-staged": "^17.2.0",
    "nock": "^13.5.6",
    "nodemon": "^3.1.14",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.5",
    "prettier-plugin-jinja-template": "^2.2.0",
    "sass": "^1.101.0",
    "sinon": "^21.1.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "typescript": "^5.9.3",
    "wiremock": "^3.13.2"
  },
  "overrides": {
    "@opentelemetry/core": "2.10.0"
  }
}
