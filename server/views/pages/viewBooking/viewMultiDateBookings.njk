{% extends "partials/layout.njk" %}

{% from "moj/components/date-picker/macro.njk" import mojDatePicker %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "partials/simplePagination.njk" import simplePagination %}
{% from "govuk/components/input/macro.njk" import govukInput %}

{% set type = session.req.routeContext.type %}
{% set pageTitle = "Video link bookings" %}

{% block content %}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-three-quarters">
            <h1 class="govuk-heading-l govuk-!-display-none-print">{{ pageTitle }}</h1>
            <p class='govuk-body govuk-!-display-none-print'>You can view and change video link bookings across multiple days, up to one month, for all the {{ 'courts' if type == 'court' else 'probation teams' }} you have selected in the "Manage your list of {{ 'courts' if type == 'court' else 'probation teams' }}" section.</p>
        </div>
    </div>

    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
            <form method='GET' class="search-form">
                <h2 class="govuk-heading-m">Filter by {{ "court" if type == 'court' else "team" }} and date</h2>

                <div class="flex flex-wrap">
                    <div class="flex-1">
                        <div class="horizontal-form horizontal-form--row-gap govuk-!-margin-bottom-6">
                            {% if agencies.length > 1 %}
                                {% set items = [{ text: "All", value: "ALL" }] %}
                                {% for agency in agencies %}
                                    {% set items = (items.push({
                                        value: agency.code,
                                        text: agency.description,
                                        selected: session.req.query.agencyCode == agency.code
                                    }), items) %}
                                {% endfor %}
                                {{ govukSelect({
                                    name: "agencyCode",
                                    id: "agencyCode",
                                    label: { text: "Court" if type == 'court' else "Probation team" },
                                    items: items,
                                    attributes: { 'data-custom-id': ('court' if type == 'court' else 'probation-team') + '-select' }
                                }) }}
                            {% else %}
                                {% set items = [] %}
                                {% for agency in agencies %}
                                    {% set items = (items.push({
                                        value: agency.code,
                                        text: agency.description,
                                        selected: session.req.query.agencyCode == agency.code
                                    }), items) %}
                                {% endfor %}
                                {{ govukSelect({
                                    name: "agencyCode",
                                    id: "agencyCode",
                                    label: { text: "Court" if type == 'court' else "Probation team" },
                                    items: items,
                                    attributes: { 'data-custom-id': ('court' if type == 'court' else 'probation-team') + '-select' }
                                }) }}
                            {% endif %}

                            {{ mojDatePicker({
                                id: 'fromDate',
                                name: 'fromDate',
                                label: { text: "From date" },
                                errorMessage: {} if validationErrors | findError('fromDate'),
                                value: session.req.query.fromDate or now() | formatDate('dd/MM/yyyy')
                            }) }}
                            {{ mojDatePicker({
                                id: 'toDate',
                                name: 'toDate',
                                label: { text: "To date" },
                                errorMessage: {} if validationErrors | findError('toDate'),
                                value: session.req.query.toDate or now() | formatDate('dd/MM/yyyy')
                            }) }}
                        </div>

                        {% if type == 'court' %}
                            {{ govukRadios({
                                classes: "govuk-radios--inline govuk-radios--small",
                                name: "onlyMissingCourtHearingLink",
                                id: "only-missing-court-hearing-link",
                                attributes: { 'data-custom-id': 'missing-court-hearing-link-radio' },
                                fieldset: {
                                    legend: {
                                        text: "Only show bookings with missing hearing links"
                                    }
                                },
                                items: [
                                    {
                                        value: "true",
                                        text: "Yes",
                                        checked: onlyMissingCourtHearingLink,
                                        attributes: { 'data-custom-id': 'missing-court-hearing-link-radio-yes' }
                                    },
                                    {
                                        value: "false",
                                        text: "No",
                                        checked: not onlyMissingCourtHearingLink,
                                        attributes: { 'data-custom-id': 'missing-court-hearing-link-radio-no' }
                                    }
                                ]
                            }) }}
                        {% else %}
                            {{ govukRadios({
                                classes: "govuk-radios--inline govuk-radios--small",
                                name: "onlyMissingProbationOfficerDetails",
                                id: "only-missing-probation-officer-details",
                                attributes: { 'data-custom-id': 'missing-probation-officer-link-radio' },
                                fieldset: {
                                    legend: {
                                        text: "Only show bookings with missing probation officer details"
                                    }
                                },
                                items: [
                                    {
                                        value: "true",
                                        text: "Yes",
                                        checked: onlyMissingProbationOfficerDetails,
                                        attributes: { 'data-custom-id': 'missing-probation-officer-link-radio-yes' }
                                    },
                                    {
                                        value: "false",
                                        text: "No",
                                        checked: not onlyMissingProbationOfficerDetails,
                                        attributes: { 'data-custom-id': 'missing-probation-officer-link-radio-no' }
                                    }
                                ]
                            }) }}
                        {% endif %}

                        {% call govukDetails({
                            summaryText: "Search by prisoner",
                            open: true if firstName or lastName or prisonerNumber else false
                        }) %}
                            <p class="govuk-body">You must include either a name or prisoner number</p>

                            {{ govukInput({
                                label: {
                                    text: "First name"
                                },
                                classes: "govuk-input--width-20",
                                id: "first-name",
                                name: "firstName",
                                value: firstName,
                                attributes: { 'data-custom-id': 'first-name' }
                            }) }}

                            {{ govukInput({
                                label: {
                                    text: "Last name"
                                },
                                classes: "govuk-input--width-20",
                                id: "last-name",
                                name: "lastName",
                                value: lastName,
                                attributes: { 'data-custom-id': 'first-name' }
                            }) }}

                            {{ govukInput({
                                label: {
                                    text: "Prison number"
                                },
                                classes: "govuk-input--width-20",
                                id: "prisoner-number",
                                name: "prisonerNumber",
                                value: prisonerNumber,
                                attributes: { 'data-custom-id': 'prisoner-number' }
                            }) }}
                        {% endcall %}
                    </div>

                    <div class="horizontal-form self-start">
                        {% set sortByItems = [
                            { text: "Court, date and time" if type == 'court' else "Team, date and time", value: "AGENCY_DATE_TIME", selected: session.req.query.sort == 'AGENCY_DATE_TIME', attributes: { 'data-custom-id': 'sort-court-date-time-select' } },
                            { text: "Date and time", value: "DATE_TIME", selected: session.req.query.sort == 'DATE_TIME', attributes: { 'data-custom-id': 'sort-date-time-select' } }
                        ] %}
                        {{ govukSelect({
                            name: "sort",
                            id: "sort",
                            label: { text: "Sort by" },
                            items: sortByItems,
                            attributes: { 'data-custom-id': 'sort-select' }
                        }) }}
                    </div>
                </div>

                {{ govukButton({ text: "Update results", type: "submit", classes: "govuk-!-display-none-print govuk-!-margin-bottom-0", attributes: { 'data-custom-id': 'update-results' } }) }}
            </form>

            <hr class="govuk-section-break govuk-section-break--l govuk-section-break--visible govuk-!-display-none-print" aria-hidden="true">

            {% if appointments.length %}
                {% set rows = [] %}
                {% for item in appointments %}
                    {% set viewOrEditText = 'View or edit' if item.appointmentDate | parseDate | dateAtTime(item.startTime | parseDate('HH:mm')) > now() else 'View' %}

                    {% set rows = (rows.push([
                        { text: item.appointmentDate | formatDate('dd/MM/yyyy') },
                        { text: item.startTime + ' to ' + item.endTime, attributes: { 'data-sort-value': item.startTime | parseDate('HH:mm') | formatDate("HHmm") } },
                        { html: '<div>' + (item.prisonerFirstName + ' ' + item.prisonerLastName) | convertToTitleCase + '</div>' +
                            '<div class="govuk-hint govuk-!-margin-bottom-0">' + item.prisonerNumber + '</div>' },
                        { html: '<div>'+ item.prisonLocDesc +'</div><div class="govuk-hint govuk-!-margin-bottom-0">' + item.prisonName + '</div>' +
                            ('<strong class="govuk-tag govuk-tag--red govuk-tag--small">Action: provide hearing link</strong>' if item.appointmentType == 'VLB_COURT_MAIN' and not item.videoUrl and not item.hmctsNumber) },
                        { text: item.courtDescription if type == 'court' else item.probationTeamDescription },
                        { html: '<div>' + (item.hearingTypeDescription or item.probationMeetingTypeDescription) + '</div>' +
                            ('<strong class="govuk-tag govuk-tag--small">Pre-court hearing</strong>' if item.appointmentType == 'VLB_COURT_PRE') +
                            ('<strong class="govuk-tag govuk-tag--small">Post-court hearing</strong>' if item.appointmentType == 'VLB_COURT_POST') },
                        { html: '<a class="govuk-link govuk-link--no-visited-state" href="view-booking/' + item.videoBookingId + '">' + viewOrEditText + '</a>' if item.appointmentType == 'VLB_COURT_MAIN' or item.appointmentType == 'VLB_PROBATION' else '<span class="govuk-visually-hidden">Not selectable</span>'}
                    ]
                    ), rows) %}
                {% endfor %}

                <div class="flex items-baseline-last">
                    {{ simplePagination(pagination)  }}

                    <div class="hmpps-action-bar">
                        <div class="hmpps-print-and-export hmpps-print-and-export--negative-margin">
                            <button data-custom-id="export-csv-link" class="hmpps-print-and-export--export" data-qa="export-bookings">Export as spreadsheet (.csv file)</button>
                            <a data-custom-id="print-bookings-link" class="hmpps-print-and-export--link" href="view-booking/print-bookings" rel="noreferrer noopener" target="_blank" data-qa='print-bookings' aria-label="Print list">
                                Print list<span class="govuk-visually-hidden">(opens in new tab)</span>
                            </a>
                        </div>
                    </div>
                </div>

                <div class="govuk-!-display-none-print">
                    {{ govukTable({
                        head: [
                            { text: "Date" },
                            { text: "Time" },
                            { text: "Name" },
                            { text: "Prison location" },
                            { text: "Court" if type == 'court' else 'Probation team' },
                            { text: "Hearing type" if type == 'court' else 'Meeting type' },
                            { text: "Action"}
                        ],
                        rows: rows
                    }) }}
                </div>

                {{ simplePagination(pagination)  }}
            {% else %}
                <p class="govuk-body">There are no video link bookings that match the search.</p>
            {% endif %}
        </div>
    </div>
{% endblock %}
